# Copy this file to config.yaml and edit. config.yaml is gitignored (it holds
# personal-but-not-secret values like your location). Secrets go in .env only.

# ── The brain (June 2026 cost pivot — see TODO.md "Pick the brain") ──────────
brain:
  # anthropic = Claude via the Anthropic SDK (needs ANTHROPIC_API_KEY).
  # openai_compat = any OpenAI-compatible endpoint, picked by base_url below.
  provider: anthropic
  model: claude-haiku-4-5    # 3x cheaper than Sonnet, faster, same tool quality
  max_tokens: 1024
  # openai_compat only — Gemini Flash (paid tier; no training on your data):
  #   provider: openai_compat
  #   model: gemini-2.5-flash
  #   base_url: https://generativelanguage.googleapis.com/v1beta/openai/
  #   api_key_env: GEMINI_API_KEY      # name of the .env variable holding the key
  base_url: ""
  api_key_env: GEMINI_API_KEY

wake:
  # openWakeWord model: a pretrained name (hey_jarvis, alexa, hey_mycroft,
  # hey_rhasspy) or a path to a custom .onnx — e.g. a "Hey Vato" model trained
  # with openWakeWord's free Colab notebook (no account needed; spec Phase 2).
  model: hey_jarvis
  # Detection score 0-1. Lower = more sensitive (more false wakes).
  threshold: 0.5
  # Microphone device index; -1 = system default. List devices with:
  #   python -c "from pvrecorder import PvRecorder; print(PvRecorder.get_available_devices())"
  audio_device_index: -1

vad:
  # RMS amplitude (int16) above which a frame counts as speech. Raise if Vato
  # keeps recording room noise; lower if it cuts you off.
  silence_threshold: 300
  # Seconds of silence (after speech) that ends the recording.
  silence_duration: 1.2
  # Give up if no speech is heard within this many seconds of the wake word.
  max_wait_for_speech: 6
  # Hard cap on command length.
  max_command_seconds: 12

stt:
  # mlx (Apple Silicon, default) | whisper_cpp (fallback)
  engine: mlx
  mlx_model: mlx-community/whisper-small.en-mlx
  # Only used when engine: whisper_cpp — path to a ggml model file
  # (e.g. from `brew install whisper-cpp` + downloaded ggml-base.en.bin)
  whisper_cpp_model: ""

tts:
  voice: Daniel        # dignified English butler voice, ships with macOS
  rate: 175            # words per minute

face:
  host: 127.0.0.1
  port: 8765
  # Default theme color (spec §9: warm and friendly; not married to any color)
  face_color: "#e8483f"

mute:
  # pynput hotkey syntax. Requires macOS Input Monitoring permission (see README).
  hotkey: "<cmd>+<shift>+m"

location:
  # Used by get_weather. Either give a name to geocode, or set lat/lon directly.
  name: "San Francisco"
  latitude: null
  longitude: null
  units: fahrenheit    # fahrenheit | celsius

audit:
  path: audit/audit.log

wardrobe:
  # How often the weather wardrobe (sunglasses, umbrella, frost…) re-checks
  # the sky. Quiet hours / nightcap are checked every minute regardless.
  refresh_minutes: 30

quiet_hours:                     # sleeping face state + nightcap (spec §9)
  start: "21:00"
  end: "07:00"

# iCloud shared calendar that calendar_write targets (reads cover all visible
# calendars). Needs ICLOUD_USERNAME / ICLOUD_APP_PASSWORD in .env — verify with:
#   python -m integrations.caldav_icloud
family_calendar_name: "Family"

memory:
  # SQLite file holding facts, conversation log, lists, game state (spec §10).
  db_path: memory/vato.db

websearch:                       # M5 — DuckDuckGo HTML (free, no key)
  max_results: 5
  timeout_seconds: 10

# ── M4: Telegram (spec §5) ────────────────────────────────────────────────────
# Needs TELEGRAM_BOT_TOKEN in .env (from @BotFather; also disable privacy mode
# there: /setprivacy → Disable, so the bot sees normal group messages).
# Collect the IDs below by running:  python -m integrations.telegram_bot
# Telegram stays OFF until allowed_user_ids is non-empty.

# Telegram user IDs of family members. Gates EVERYTHING: messages from anyone
# else — including DMs to the bot — are silently ignored and audit-logged.
allowed_user_ids: []
#   - 123456789                  # e.g. David
#   - 987654321                  # e.g. Mum

telegram:
  # The family group chat — where replies and Tier-3 Confirm/Refuse buttons go.
  family_chat_id: 0
  # How long a Tier-3 confirmation waits for a button tap before giving up.
  confirm_timeout_seconds: 120
